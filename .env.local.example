# Server-side variabelen (NOOIT NEXT_PUBLIC_ gebruiken voor wachtwoorden!)
READER_PASSWORD=jouw-lezerscode-hier
# Eenmalige startwachtwoorden voor beheerders/moderators zonder eigen wachtwoord.
# Daarna logt iedereen met die rol in met een eigen wachtwoord.
ADMIN_PASSWORD=jouw-beheerderswachtwoord-hier
MODERATOR_PASSWORD=jouw-moderatorwachtwoord-hier
JWT_SECRET=minimaal-32-willekeurige-tekens-hier-invullen

# Supabase (public is ok - dit zijn geen wachtwoorden)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key

# Service-role key (GEHEIM, nooit naar de browser) — alle API-routes gebruiken deze
# Te vinden in Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key-hier

# Backend API
NEXT_PUBLIC_API_URL=https://datascraperraad.onrender.com

# IMAP mailboxen voor "Ophalen uit mail" (events + ingekomen stukken)
IMAP_HOST=mail.raisehandv2.nl
IMAP_PORT=993
IMAP_EVENTS_USER=events@raisehandv2.nl
IMAP_EVENTS_PASSWORD=jouw-wachtwoord-hier
IMAP_INGEKOMEN_USER=ingekomenstukken@raisehandv2.nl
IMAP_INGEKOMEN_PASSWORD=jouw-wachtwoord-hier

# Optioneel: zet op true om een eigen wachtwoord voor alle fractieleden verplicht te maken
# (zonder eigen wachtwoord word je dan doorgestuurd naar /account). Standaard: niet verplicht.
WACHTWOORD_VERPLICHT=false

# Anthropic (persberichten, portefeuille-zoeker, mail ophalen)
ANTHROPIC_API_KEY=jouw-key-hier
